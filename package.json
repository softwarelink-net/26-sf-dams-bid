{
  "name": "26-sf-dams-bid",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "陕西飞机工业有限责任公司数字档案管理系统（信创涉密分保原型）",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.ts --max-warnings 0",
    "db:migrate": "wrangler d1 migrations apply Allworld --local",
    "db:seed": "wrangler d1 execute Allworld --local --file=./schema.sql",
    "deploy": "npm run build && wrangler deploy && node scripts/deploy-allworld.mjs 26-sf-dams-bid",
    "deploy:r2": "node scripts/deploy-allworld.mjs 26-sf-dams-bid",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "lucide-vue-next": "^0.468.0",
    "pinia": "^2.3.0",
    "pinia-plugin-persistedstate": "^3.2.3",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^4.20241218.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.20",
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-plugin-vue": "^9.32.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vue-eslint-parser": "^9.4.3",
    "wrangler": "^3.99.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
